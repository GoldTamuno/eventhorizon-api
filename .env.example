# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/eventhorizon?retryWrites=true&w=majority

# JWT (login session token)
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Email verification token
EMAIL_VERIFICATION_SECRET=replace_this_with_a_different_long_random_string
EMAIL_VERIFICATION_EXPIRES_IN_MINUTES=30

# Frontend URL used to build the verification link
FRONTEND_URL=http://localhost:3000

# Email (SMTP) credentials - example uses Gmail App Password / Mailtrap / etc.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="EventHorizon <no-reply@eventhorizon.com>"
